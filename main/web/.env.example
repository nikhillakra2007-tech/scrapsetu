# ==============================================================================
# Kabadiwala Connect (ScrapSetu) — Web Application Environment Variables
# Deployment Platform: Vercel
# ==============================================================================

# Supabase Public API (Accessible from the Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used ONLY on server-side Next.js routes, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Python Backend API (Render Deployment: Bot, Webhooks & AI Services)
# Local: http://localhost:8000
# Production: https://scrapsetu-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
