# ==============================================================================
# Kabadiwala Connect (ScrapSetu) — Web Application Environment Template
# Deployment Target: Vercel (Safe to commit to Git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud API Credentials
# ------------------------------------------------------------------------------
# Browser-accessible Supabase Project URL and Anon API key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Service Role Key (Used strictly server-side, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Supabase CLI Type Generator (Run 'npm run update-types' in main/web/)
# ------------------------------------------------------------------------------
# Option A: Full Postgres Connection URI (from Supabase -> Project Settings -> Database)
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Database Password (script extracts project ref automatically from NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Python Backend API (FastAPI + Gemini 2.5 Flash + Webhooks)
# ------------------------------------------------------------------------------
# Local development: http://localhost:8000
# Production deployment on Render: https://scrapsetu-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Next.js Web App Host URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
