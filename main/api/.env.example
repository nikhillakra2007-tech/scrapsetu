# ==============================================================================
# Kabadiwala Connect (ScrapSetu) — Python Bot & Webhook Backend
# Deployment Platform: Render (Web Service)
# ==============================================================================

# Server Environment
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Supabase Server-Side Access (Admin Service Role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API (Multimodal Scrap Classification & Intent Extraction)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI (Speech-to-Text & Text-to-Speech for Hindi/Marathi)
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech

# Telephony IVR (Exotel Voicebot Integration)
EXOTEL_ACCOUNT_SID=your-exotel-sid
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=your-virtual-exophone

# WhatsApp Business API / Cloud Webhook
WHATSAPP_API_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-secret-token

# Allowed CORS Origins (Next.js Web Client)
CORS_ORIGINS=http://localhost:3000,https://scrapsetu.vercel.app
